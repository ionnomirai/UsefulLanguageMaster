<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <ImageView
        android:id="@+id/ivBackgroundMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/background_main_1x" />

    <TextView
        android:id="@+id/tvVocabularyTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vocabularies"
        android:textSize="24sp"
        android:textColor="@color/app_name_color"
        android:fontFamily="@font/inter_bold_700"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0392156862745098"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocubalaries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvVocabularyTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bAddNewVocabulary"
        />

    <Button
        android:id="@+id/bAddNewVocabulary"
        style="@style/Button_wide"
        android:text="@string/add_new_vocabulary"
        app:layout_constraintTop_toBottomOf="@id/tvVocabularyTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.943342776203966"/>


</androidx.constraintlayout.widget.ConstraintLayout>